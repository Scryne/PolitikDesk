# PolitikDesk — ortam değişkenleri örneği
# Kopyala: cp .env.example .env

# --- Uygulama ---
PD_ENV=development
PD_LOG_LEVEL=INFO
PD_LOG_FORMAT=json          # json | console

# --- Veritabanı (Spec §11.1: PostgreSQL 16 + pgvector) ---
PD_DATABASE_URL=postgresql://politikdesk:politikdesk@localhost:5432/politikdesk

# --- Kuyruk ---
PD_REDIS_URL=redis://localhost:6379/0

# --- LLM (Spec §11.5 — tüm çağrılar llm/client.py üzerinden) ---
# UYARI (B-64): yorumlar her zaman KENDİ satırında olmalı; boş değerin
# sonuna yazılan yorum python-dotenv tarafından DEĞER sanılır.
#
# Sağlayıcı: anthropic | openai_compat
PD_LLM_PROVIDER=anthropic

# -- anthropic --
ANTHROPIC_API_KEY=
# ucuz model: iddia çıkarımı / özetleme
PD_LLM_MODEL_EXTRACTION=claude-sonnet-5
# pahalı model: taslak üretimi
PD_LLM_MODEL_GENERATION=claude-opus-5

# -- openai_compat (NVIDIA NIM ücretsiz katmanı) --
# PD_LLM_PROVIDER=openai_compat olduğunda BASE_URL ve API_KEY_ENV zorunludur.
# Model kimliği katalog kartıyla birebir aynı olmalı, hesaba açık olmalı
# (`/v1/models` ile doğrula — katalogda görünen her model açık değil) ve
# politikdesk/llm/pricing.py'de kayıtlı olmalıdır.
# D17 seçimi ve gerekçesi: docs/llm-model-benchmark.md
#   PD_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   PD_LLM_API_KEY_ENV=NVIDIA_API_KEY
#   PD_LLM_MODEL_EXTRACTION=nvidia/nemotron-3-super-120b-a12b
#   PD_LLM_MODEL_GENERATION=nvidia/nemotron-3-super-120b-a12b
#   PD_LLM_JSON_MODE=json_schema
#   PD_LLM_TIMEOUT_SECONDS=180
#   PD_LLM_MAX_RETRIES=4
NVIDIA_API_KEY=

# günlük tavan; aşılınca BudgetExceeded
PD_LLM_DAILY_BUDGET_USD=5.0
PD_LLM_MONTHLY_BUDGET_USD=100.0

# Boyut 1024 sabittir (şemada VECTOR(1024)).
# Benchmark: docs/embedding-benchmark.md — zor AUC 0,807 (özdeş çiftler hariç)
# ⚠ Boş bırakılırsa yerel `hashing` embedder kullanılır: SEMANTİK YAKINLIK
#   YAKALAMAZ, kümeleme kalitesi için YETERSİZDİR. Yalnızca geliştirme içindir.
# Embedding (D16 karari: self-host multilingual-e5-large)
# UYARI: bos deger + satir sonu yorumu python-dotenv'i yaniltir; yorumlar
# her zaman KENDI satirinda olmali.
PD_EMBEDDING_PROVIDER=local
PD_EMBEDDING_MODEL=intfloat/multilingual-e5-large
PD_EMBEDDING_DIM=1024
# Barındırılan alternatifler için (D16'da elendi, karşılaştırma koşumu için durur)
VOYAGE_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=

# --- Gözlemlenebilirlik (F0-18) ---
SENTRY_DSN=
PD_SENTRY_TRACES_SAMPLE_RATE=0.1
