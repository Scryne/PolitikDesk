# PolitikDesk — ortam değişkenleri örneği
# Kopyala: cp .env.example .env

# --- Uygulama ---
PD_ENV=development
PD_LOG_LEVEL=INFO
PD_LOG_FORMAT=json          # json | console

# --- Veritabanı (Spec §11.1: PostgreSQL 16 + pgvector) ---
PD_DATABASE_URL=postgresql://politikdesk:politikdesk@127.0.0.1:5432/politikdesk

# --- Kuyruk ---
PD_REDIS_URL=redis://127.0.0.1:6379/0

# --- LLM (Spec §11.5 — tüm çağrılar llm/client.py üzerinden) ---
# UYARI (B-64): yorumlar her zaman KENDİ satırında olmalı; boş değerin
# sonuna yazılan yorum python-dotenv tarafından DEĞER sanılır.
#
# Sağlayıcı: anthropic | openai_compat | hybrid
PD_LLM_PROVIDER=anthropic

# -- anthropic --
ANTHROPIC_API_KEY=
# ucuz model: iddia çıkarımı / özetleme
PD_LLM_MODEL_EXTRACTION=claude-sonnet-5
# pahalı model: taslak üretimi
PD_LLM_MODEL_GENERATION=claude-opus-5

# -- hybrid (ÖNERİLEN: Yerel GPU Ollama [Çıkarım] + NVIDIA NIM Bulut [Editoryal Üretim]) --
# Yerel RTX GPU ile sınırsız & ücretsiz iddia çıkarma, bulut 70B+ modeliyle derin editoryal analiz.
# Otomatik Fallback: Biri hata verirse diğeri anında devreye girer.
#   PD_LLM_PROVIDER=hybrid
#   PD_LLM_EXTRACTION_BASE_URL=http://127.0.0.1:11434/v1
#   PD_LLM_MODEL_EXTRACTION=qwen2.5:7b-instruct-q5_K_M
#   PD_LLM_EXTRACTION_JSON_MODE=json_object
#
#   PD_LLM_GENERATION_BASE_URL=https://integrate.api.nvidia.com/v1
#   PD_LLM_GENERATION_API_KEY_ENV=NVIDIA_API_KEY
#   PD_LLM_MODEL_GENERATION=meta/llama-3.3-70b-instruct
#   PD_LLM_GENERATION_JSON_MODE=json_schema
#   PD_LLM_FALLBACK_ENABLED=true
#
# -- openai_compat (Seçenek A: Yerel Ollama / LM Studio / vLLM - 100% Çevrimdışı/Lokal) --
#   PD_LLM_PROVIDER=openai_compat
#   PD_LLM_BASE_URL=http://127.0.0.1:11434/v1
#   PD_LLM_API_KEY_ENV=
#   PD_LLM_MODEL_EXTRACTION=qwen2.5:7b-instruct-q5_K_M
#   PD_LLM_MODEL_GENERATION=qwen2.5:7b-instruct-q5_K_M
#   PD_LLM_JSON_MODE=json_object
#
# -- openai_compat (Seçenek B: NVIDIA NIM ücretsiz bulut katmanı) --
# PD_LLM_PROVIDER=openai_compat olduğunda BASE_URL ve API_KEY_ENV zorunludur.
# Model kimliği katalog kartıyla birebir aynı olmalı, hesaba açık olmalı
# (`/v1/models` ile doğrula — katalogda görünen her model açık değil) ve
# politikdesk/llm/pricing.py'de kayıtlı olmalıdır.
# D17 seçimi ve gerekçesi: docs/llm-model-benchmark.md
#   PD_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   PD_LLM_API_KEY_ENV=NVIDIA_API_KEY
#   PD_LLM_MODEL_EXTRACTION=nvidia/nemotron-3-ultra-550b-a55b
#   PD_LLM_MODEL_GENERATION=nvidia/nemotron-3-ultra-550b-a55b
#
# YENİDEN SEÇİM (2026-09-26): NIM modelleri haber vermeden emekliye ayrılıyor ve 410 Gone
# döndürüyor. meta/llama-3.1-8b ve llama-3.3-70b 2026-08-26'da, openai/gpt-oss-120b
# 2026-09-03'te kalktı; o tarihten beri iddia çıkarımı ve taslak üretimi çalışmıyordu.
# Ölçüm (scripts.llm_benchmark 6 makale, scripts.generation_benchmark 3 olay x 3 açı):
#   model                              çıkarım kabul  alıntı  taslak grounding  hata
#   nvidia/nemotron-3-ultra-550b-a55b  10/10          %100    7/8 (%88)          1   <- SEÇİLDİ
#   nvidia/nemotron-3-super-120b-a12b  5/6            %100    2/2 (7 çağrı hata)  10
#   deepseek-v4.1-flash, glm-5.3, gpt-oss-20b         hepsi hata (boş yanıt / aşırı yük)
# ultra'nın 13 Ağu ölçümündeki %60 grounding'i bu turda tekrarlanmadı (0 uydurma atıf);
# kanıt dışı kalan tek sayıyı grounding_check sert kapısı zaten reddeder. Ölçümü aylık tekrarla.
#
# ÜRETİM MODELİ SEÇİMİ (F5-15, 13 Ağu 2026 — ücretsiz katmanda ölçüldü):
#   model                              grounding  sözleşme  gecikme
#   meta/llama-3.3-70b-instruct        100%       100%      41 sn   <- SEÇİLDİ
#   openai/gpt-oss-120b                100%        88%      50 sn
#   nvidia/nemotron-3-super-120b        89%       100%      22 sn   (eski)
#   nvidia/nemotron-3-ultra-550b        60%       100%      28 sn
#   z-ai/glm-5.2                       404 — hesaba açık değil
#   mistralai/mistral-large-2-instruct 404 — hesaba açık değil
#
# Karar grounding'e dayanıyor: G3 koşul 2 "taslakta kanıtta olmayan
# sayı/tarih = %0" SERT kapıdır. nemotron-3-super kanıtta olmayan bir
# TARİH üretti (%89); llama-3.3-70b dokuz çağrının dokuzunda temiz geçti.
# Türkçesi de belirgin daha iyi ("isimlerindendir" vs "bu üç isimlerin")
# ve `critique` açısı ilk kez gerçek bir eleştiri üretiyor.
# EN BÜYÜK MODEL EN İYİSİ DEĞİL: nemotron-3-ultra-550b en kötü grounding'i
# verdi (%60) ve beş uydurma atıf üretti.
#   PD_LLM_JSON_MODE=json_schema
#   PD_LLM_TIMEOUT_SECONDS=180
#   PD_LLM_MAX_RETRIES=4
NVIDIA_API_KEY=

# --- TÜİK SDMX servisi (F5-02 · B-42) ---
# TÜİK'in bülten listesi sunucu tarafında OKUNAMAZ: veriportali ve
# data.tuik.gov.tr React SPA olarak yükleniyor ve /swagger/v1/swagger.json
# bile aynı "JavaScript gerekli" kabuğunu döndürür. Sunucudan okunabilen
# tek uç SDMX servisidir: https://nsiws.tuik.gov.tr/rest/...
#
# O uç kimlik doğrulama ister ve 401'i WWW-Authenticate BAŞLIĞI OLMADAN
# döndürür — şema ilan edilmiyor. Hangi biçimde gönderileceğini
# `python -m scripts.probe_tuik` deneyerek bulur (anahtarı ekrana basmaz).
#
# Dolaylı desen (PD_LLM_API_KEY_ENV ile aynı, B-64): aşağıdaki değişken
# anahtarın KENDİSİNİ değil, anahtarı taşıyan değişkenin ADINI tutar.
PD_TUIK_API_KEY_ENV=TUIK_API_KEY
TUIK_API_KEY=

# --- TCMB EVDS (Faz 1.1) ---------------------------------------------------
# Politika faizi, kur, rezervler ve enflasyon beklentisi serilerinin
# makine okunur kaynağı. Anahtar evds2.tcmb.gov.tr üzerinden ÜCRETSİZ alınır.
#
# ⚠️ EVDS, anahtarsız istekte HTTP 200 ile bir React SPA kabuğu döndürür
# (18 Ağu 2026'da ölçüldü: text/html, 1354 bayt). Yani "200 aldım, demek ki
# çalışıyor" YANLIŞTIR — bu depo aynı sessiz arızayı B-42 (TÜİK portalı) ve
# B-43 (Hazine duyuruları) ile iki kez yaşadı. `adapters/evds.py` gövdeyi
# ayrıştırmadan önce HTML denetimi yapar ve HTML görürse istisna fırlatır.
#
# Anahtarı ekledikten sonra seri kodlarını DOĞRULAYIN:
#     python -m scripts.probe_evds
# Betik canlı uçtan seri adını okur ve hangi serilerin `verified=True`
# yapılabileceğini yazdırır. Doğrulanmamış seri hiçbir sayı üretmez.
PD_EVDS_API_KEY_ENV=EVDS_API_KEY
EVDS_API_KEY=

# günlük tavan; aşılınca BudgetExceeded
PD_LLM_DAILY_BUDGET_USD=5.0
PD_LLM_MONTHLY_BUDGET_USD=100.0

# Boyut 1024 sabittir (şemada VECTOR(1024)).
# Benchmark: docs/embedding-benchmark.md — zor AUC 0,807 (özdeş çiftler hariç)
# ⚠ Boş bırakılırsa yerel `hashing` embedder kullanılır: SEMANTİK YAKINLIK
#   YAKALAMAZ, kümeleme kalitesi için YETERSİZDİR. Yalnızca geliştirme içindir.
# Embedding (D16 karari: self-host multilingual-e5-large)
# UYARI: bos deger + satir sonu yorumu python-dotenv'i yaniltir; yorumlar
# her zaman KENDI satirinda olmali.
PD_EMBEDDING_PROVIDER=local
PD_EMBEDDING_MODEL=intfloat/multilingual-e5-large
PD_EMBEDDING_DIM=1024
# Barındırılan alternatifler için (D16'da elendi, karşılaştırma koşumu için durur)
VOYAGE_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=

# --- Gözlemlenebilirlik (F0-18) ---
SENTRY_DSN=
PD_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Faz 3: tek kullanıcı (kişisel araç kararı) ---
# Kimlik doğrulama katmanı yoktur (bkz. docs/karar-itirazlari.md İtiraz-8);
# `users` satırı yine de gerekir çünkü drafts/profiles/briefings ona bakar.
PD_USER_EMAIL=local@politikdesk.local
PD_USER_DISPLAY_NAME=PolitikDesk

# --- Faz 3: brifing (F3-16, F3-17) ---
# Brifing saatleri (konteynerin saat diliminde; compose TZ=Europe/Istanbul verir)
PD_BRIEFING_MORNING_HOUR=8
PD_BRIEFING_EVENING_HOUR=20
PD_BRIEFING_MIN_EVENTS=5
PD_BRIEFING_MAX_EVENTS=7

# SMTP BOŞ BIRAKILABİLİR: brifing yine üretilir ve /briefing/<tarih>
# sayfasında görünür, yalnızca e-posta gönderilmez.
PD_SMTP_HOST=
PD_SMTP_PORT=587
PD_SMTP_USER=
PD_SMTP_PASSWORD=
PD_SMTP_FROM=
PD_SMTP_STARTTLS=true

# E-postadaki olay linkleri MUTLAK olmalı — göreli adres e-posta
# istemcisinde hiçbir şeye çözülmez (F3-17 DoD).
PD_PUBLIC_BASE_URL=http://localhost:8000

# --- Faz 3: taslak üretimi (F3-10) ---
# Taslak uzunluğu üst sınırı; şema `maxLength` olarak da zorlar.
PD_DRAFT_MAX_CHARS=600

# --- Faz 4: yedekleme konumu (B-84) ---
# Yedek makale alintisi, editoryal profil ve taslak icerir.
#
# BOS BIRAKIN: varsayilan zaten bulut esitlemesinin disidir
#   Windows -> %LOCALAPPDATA%\PolitikDesk\backups
#   Linux   -> ~/.local/share/politikdesk/backups
#
# ⚠ Bulut altindaki bir yol (OneDrive/Dropbox/Google Drive) REDDEDILIR.
# BitLocker diski korur, bulut kopyasini KORUMAZ — gerekce
# `politikdesk/backup_policy.py` basliginda.
PD_BACKUP_DIR=

# --- Siyaset Dikeyi & Sosyal Medya Entegrasyonu (Spec v3.5 §9.4, §12.4, §14) ---
# X / Twitter köprüsü (Self-hosted RSSHub: http://rsshub:1200 veya http://localhost:1200)
PD_TWITTER_BRIDGE_URL=http://localhost:1200
PD_RSSHUB_BRIDGE_URL=http://localhost:1200

# RSSHub Twitter oturum bilgileri (Twitter/X kısıtlamalarını aşmak için opsiyonel çerezler)
PD_TWITTER_COOKIES=
PD_TWITTER_AUTH_TOKEN=

# X / Twitter API kimlik bilgileri (Mock veya Canlı gönderim)
X_API_KEY=
X_API_SECRET=

# --- Özellik Bayrakları (Feature Flags & Rollback Toggles) ---
# Twitter köprünüz henüz aktif değilse 'false' yaparak boru hattını temiz tutabilirsiniz.
PD_TWITTER_INGESTION_ENABLED=false
PD_LIVE_NOTIFICATIONS_ENABLED=true
PD_RERANKER_ENABLED=true
PD_SOCIAL_PUBLISH_ENABLED=false

# --- Otomatik Tweet Üretimi (Auto-Draft) & Telegram Anlık Bildirim (Spec §12.4, §15) ---
# Teyit zincirinden başarıyla geçen her yeni haber için arka planda otomatik tweet üretimi
PD_AUTO_DRAFT_ENABLED=true
PD_AUTO_DRAFT_MIN_SALIENCE=30
PD_AUTO_DRAFT_ANGLE=inform
PD_AUTO_DRAFT_MAX_EVENTS_PER_CYCLE=5

# Telegram Bot Anlık Bildirimleri (@BotFather'dan alınan token ve @userinfobot'tan alınan chat_id)
# Ayarlandığında, üretilen her tweet tek tıkla X'te paylaşma butonuyla birlikte Telegram'ınıza düşer.
PD_TELEGRAM_BOT_TOKEN=
PD_TELEGRAM_CHAT_ID=
PD_TELEGRAM_NOTIFY_DRAFTS=true

# Bilerek buluta yazmak icin 1 yapin (ornegin yedegi kendiniz
# sifreliyorsaniz). Sessiz gecis yok: acikca belirtilmeli.
PD_BACKUP_ALLOW_CLOUD=
